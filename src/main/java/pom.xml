pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                bat 'checkout'
            }
        }

        stage('Build and Test') {
            steps {
                bat 'mvn clean'
            }
        }

        stage('Package') {
            steps {
                bat 'mvn package'
            }
        }
    }

    post {
        success {
            echo 'Build Success'
        }

        failure {
            echo 'Build Failure'
        }
    }
}